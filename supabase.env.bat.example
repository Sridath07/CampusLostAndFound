@echo off
REM Copy this file to supabase.env.bat and fill in the connection values from
REM Supabase Dashboard > Connect > Session pooler (or direct connection).
REM Keep supabase.env.bat private. Do not commit or share it.
set "SUPABASE_JDBC_URL=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require"
set "SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF"
set "SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD"
